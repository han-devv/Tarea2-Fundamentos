Package cc;

Helpers
    caracter = [32..57] | [59..90] | 92 | [94..255];

Tokens
    c_izq = '[';
    c_der = ']';
    d_puntos = ':';
    texto = caracter+;
    saltos = (10 | 13)+;

Ignored Tokens
    saltos;

Productions
    linea = c_izq [izq]:texto d_puntos [adentro]:fragmento* c_der [afuera]:fragmento*;

    fragmento =
        {txt} texto |
        {col} d_puntos;
Helpers
    letra = (['a'..'z']|['A'..'Z']|'á'|'é'|'í'|'ó'|'ú'|'ä'|'ë'|'ï'|'ö'|'ü');
    digito = ['0'..'9'];
    simb = [0..0xffff];

Tokens
    l_brack = '[';
    r_brack = ']';
    points = ':';
    point = '.';
    catg = 'id' | 'ar' | 'ti' | 'by' | 're' | 've';
    titulo = (letra|simb|digito)+;
    blank = (' '| 10 | 13 )+;
    min = digito+;
    seg = digito+;
    ms = digito+;

Ignored Tokens
    blank;

Productions
    line =
        {data} l_brack catg points cadena r_brack |
        {song} l_brack tiempo r_brack cadena;

    tiempo = min points seg point ms;

    cadena = 
        {simple} titulo | 
        {compuesta} titulo cadena;
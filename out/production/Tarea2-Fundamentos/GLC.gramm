Package cc;

Helpers
    digito = ['0'..'9'];
    todos = [0..0xffff];
    caracteres_texto = [todos - ['[' + [']' + [':' + ['.' + [10 + 13]]]]]];

Tokens
    l_brack = '[';
    r_brack = ']';
    points = ':';
    point = '.';
    catg = 'id' | 'ar' | 'ti' | 'al' | 'by' | 're' | 've';

    numero = digito+;
    titulo = caracteres_texto+;
    blank = (' '| 10 | 13 )+;

Ignored Tokens
    blank;

Productions
    line =
        {data} l_brack catg points cadena r_brack |
        {song} l_brack tiempo r_brack cadena;

    tiempo = [min]:numero points [seg]:numero point [ms]:numero;

    cadena =
        {simple} titulo |
        {compuesta} titulo cadena;